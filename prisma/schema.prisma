// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  phone                   String?
  passwordHash            String
  role                    String
  status                  String
  team                    String
  avatar                  String
  assignments             CaseAssignment[]
  meetings                MeetingParticipant[]
  notificationPreferences NotificationPreferences?
  documents               Document[]
  auditLogs               AuditLog[]
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String
}

model Account {
  id               String     @id @default(cuid())
  name             String     @unique
  industry         String
  createdAt        DateTime
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  owner            String
  size             String?
  location         String?
  contacts         Contact[]
  documents        Document[]
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  company   String
  role      String
  notes     String?
  avatar    String
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  cases     Case[]
  tasks     Task[]
  meetings  Meeting[]
}

model Case {
  id                 String           @id
  subject            String
  customer           String
  email              String
  priority           String
  type               String
  status             String
  createdAt          DateTime
  resolvedAt         DateTime?
  description        String
  communications     Json[]
  contactId          String?
  satisfactionRating Int?
  assignments        CaseAssignment[]
  createdById        String
  createdBy          User             @relation(fields: [createdById], references: [id])
  contact            Contact?         @relation(fields: [contactId], references: [id])
  documents          Document[]
  tasks              Task[]
}

model CaseAssignment {
  id               String   @id @default(cuid())
  case             Case     @relation(fields: [caseId], references: [id])
  caseId           String
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     DateTime?
  priority    String
  linkedCase  String?
  assignedTo  String?
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  case        Case?     @relation(fields: [linkedCase], references: [id])
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String
  date         DateTime
  status       String
  linkedRecord String?
  notes        Json[]
  attachments  Json[]
  contactId    String?
  participants MeetingParticipant[]
  contact      Contact?             @relation(fields: [contactId], references: [id])
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  meetingId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime @default(now())
}

model Document {
  id           String   @id @default(cuid())
  name         String
  type         String
  size         String
  uploadedAt   DateTime
  uploadedBy   String
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id])
  category     String
  description  String?
  previewUrl   String?
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id])
  caseId       String?
  case         Case?    @relation(fields: [caseId], references: [id])
  linkedToId   String?
  linkedToType String?
}

model Email {
  id           String    @id @default(cuid())
  ownerEmail   String
  from         Json
  to           Json
  subject      String
  body         String
  date         DateTime
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json[]
  messageId    String?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime
}

model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  configured     Boolean
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
}

model GlobalNotificationPreferences {
  id       String @id @default(cuid())
  cases    Json
  tasks    Json
  meetings Json
}

model NotificationPreferences {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  cases    Json
  tasks    Json
  meetings Json
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   DateTime
  read        Boolean
  userId      String?
  link        String
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}
