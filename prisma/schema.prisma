// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  passwordHash            String
  role                    String
  status                  String
  team                    String
  avatar                  String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  notificationPreferences NotificationPreferences?
}

model NotificationPreferences {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id])
  userId  String @unique
  cases   Json
  tasks   Json
  meetings Json
}

model GeneralSettings {
    id          String @id @default(cuid())
    systemName  String
    companyName String
    logoUrl     String
    timeZone    String
    language    String
}

model EmailSettings {
    id              String @id @default(cuid())
    smtpHost        String
    smtpPort        Int
    smtpUser        String
    smtpPass        String
    smtpEncryption  String
    imapHost        String
    imapPort        Int
    imapUser        String
    imapPass        String
    imapEncryption  String
    configured      Boolean @default(false)
}

model GlobalNotificationPreferences {
    id        String @id @default(cuid())
    cases     Json
    tasks     Json
    meetings  Json
}

model Workflow {
    id          String @id @default(cuid())
    name        String
    trigger     String
    condition   String
    action      String
}

model AuditLog {
    id          String @id @default(cuid())
    userId      String
    action      String
    details     String
    timestamp   DateTime @default(now())
}


model Account {
  id        String   @id @default(cuid())
  name      String   @unique
  industry  String
  owner     String
  createdAt DateTime @default(now())
  address   String?
  phone     String?
  email     String?
  website   String?
  primaryContactId String?
  contacts  Contact[]
  documents Document[]
}

model Contact {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  company   String
  accountId String?
  role      String?
  notes     String?
  avatar    String?
  account   Account?  @relation(fields: [accountId], references: [id])
  cases     Case[]
  tasks     Task[]
  meetings  Meeting[]
}

model Case {
  id                 String          @id @default(cuid())
  subject            String
  customer           String
  email              String
  priority           String
  type               String
  status             String
  assignedTo         String
  createdAt          String
  resolvedAt         String?
  description        String
  communications     Communication[]
  contactId          String?
  contact            Contact?        @relation(fields: [contactId], references: [id])
  satisfactionRating Int?
  tasks              Task[]
  documents          Document[]
}

model Communication {
  id         String @id @default(cuid())
  type       String
  content    String
  author     String
  authorRole String
  timestamp  String
  caseId     String?
  case       Case?  @relation(fields: [caseId], references: [id])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     String
  priority    String
  linkedCase  String?
  assignedTo  String?
  contactId   String?
  case        Case?    @relation(fields: [linkedCase], references: [id])
  contact     Contact? @relation(fields: [contactId], references: [id])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String
}

model Document {
  id           String  @id @default(cuid())
  name         String
  type         String
  size         String
  uploadedAt   String
  uploadedBy   String
  category     String
  description  String?
  linkedToType String
  linkedToId   String
  previewUrl   String?
  account      Account? @relation(fields: [linkedToId], references: [id])
  case         Case?    @relation(fields: [linkedToId], references: [id])
}

model Meeting {
  id           String   @id @default(cuid())
  title        String
  description  String
  date         String
  status       String
  participants String[]
  linkedRecord String?
  notes        Json?
  attachments  Json?
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   String
  read        Boolean
  userId      String?
  link        String
}

model Email {
  id           String  @id @default(cuid())
  from         Json
  to           Json
  subject      String
  body         String
  date         String
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json?
}
