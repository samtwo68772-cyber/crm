
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:wR78ZKGathYtcANaYcK6@containers-us-west-111.railway.app:7054/railway"
}


model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  passwordHash String
  role      String // "admin" or "staff"
  status    String // "Active" or "Inactive"
  team      String
  avatar    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments             CaseAssignment[]
  meetingsAsParticipant   MeetingParticipant[]
  auditLogs               AuditLog[]
  tasksCreated            Task[]
  notificationPreferences NotificationPreferences?
}


model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  leaderId    String
  memberIds   String[]
  status      String // "Active" or "Archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Case {
  id        String   @id
  subject   String
  customer  String
  email     String
  priority  String
  type      String
  status    String
  createdAt String
  resolvedAt        String?
  description       String
  communications    Json?
  contactId         String?
  satisfactionRating Int?

  assignments CaseAssignment[]
  contact     Contact?         @relation(fields: [contactId], references: [id])
  tasks       Task[]
  documents   Document[]
}

model CaseAssignment {
  id         String   @id @default(cuid())
  case       Case     @relation(fields: [caseId], references: [id])
  caseId     String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     String
  priority    String
  linkedCase  String?
  assignedTo  String?
  contactId   String?

  case      Case?    @relation(fields: [linkedCase], references: [id])
  assignee  User?    @relation(fields: [assignedTo], references: [id])
  contact   Contact? @relation(fields: [contactId], references: [id])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String
  accountId String?
  role      String
  notes     String?
  avatar    String
  cases     Case[]
  tasks     Task[]
  account   Account? @relation(fields: [accountId], references: [id])
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String?
  date         String
  status       String
  linkedRecord String?
  notes        Json?
  attachments  Json?
  contactId    String?
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  meetingId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime @default(now())
}


model Account {
  id               String    @id @default(cuid())
  name             String    @unique
  industry         String
  createdAt        DateTime
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  owner            String
  size             String?
  location         String?
  contacts         Contact[]
  documents        Document[]
}

model Document {
  id          String   @id @default(cuid())
  name        String
  type        String
  size        String
  uploadedAt  String
  uploadedBy  String
  category    String
  description String?
  accountId   String?
  caseId      String?
  previewUrl  String?
  account     Account? @relation(fields: [accountId], references: [id])
  case        Case?    @relation(fields: [caseId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Email {
  id           String @id @default(cuid())
  from         Json
  to           Json
  subject      String
  body         String
  date         String
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json?
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   String
  read        Boolean
  userId      String?
  link        String
}

model GeneralSettings {
    id String @id @default(cuid())
    systemName String
    companyName String
    logoUrl String
    timeZone String
    language String
}

model EmailSettings {
    id String @id @default(cuid())
    smtpHost String
    smtpPort Int
    smtpUser String
    smtpPass String
    smtpEncryption String
    imapHost String
    imapPort Int
    imapUser String
    imapPass String
    imapEncryption String
    configured Boolean
}

model NotificationPreferences {
    id String @id @default(cuid())
    userId String @unique
    cases Json
    tasks Json
    meetings Json
    user User @relation(fields: [userId], references: [id])
}

model GlobalNotificationPreferences {
    id String @id @default(cuid())
    cases Json
    tasks Json
    meetings Json
}

model Workflow {
    id String @id @default(cuid())
    name String
    trigger String
    condition String
    action String
}
