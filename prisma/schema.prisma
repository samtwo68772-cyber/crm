// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  passwordHash            String
  role                    String
  status                  String
  team                    String
  avatar                  String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  assignments             CaseAssignment[]
  tasks                   Task[]
  meetingsAsParticipant   MeetingParticipant[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreferences?
}

model Case {
  id                   String           @id @default(cuid())
  subject              String
  customer             String
  email                String
  priority             String
  type                 String
  status               String
  createdAt            String
  resolvedAt           String?
  description          String
  communications       Json[]           @default([])
  contactId            String?
  satisfactionRating   Int?
  assignments          CaseAssignment[]
  contact              Contact?         @relation(fields: [contactId], references: [id])
  tasks                Task[]
  documents            Document[]
}

model CaseAssignment {
  id         String   @id @default(cuid())
  case       Case     @relation(fields: [caseId], references: [id])
  caseId     String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  assignedAt DateTime @default(now())

  @@unique([caseId, userId])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     String
  priority    String
  linkedCase  String?
  assignedTo  String?
  contactId   String?
  user        User?    @relation(fields: [assignedTo], references: [id])
  case        Case?    @relation(fields: [linkedCase], references: [id])
  contact     Contact? @relation(fields: [contactId], references: [id])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String
  accountId String
  role      String
  notes     String?
  avatar    String
  account   Account  @relation(fields: [accountId], references: [id])
  cases     Case[]
  tasks     Task[]
}

model Team {
  id          String @id @default(cuid())
  name        String @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String
}

model Account {
  id               String    @id @default(cuid())
  name             String
  industry         String
  createdAt        DateTime
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  owner            String
  size             String?
  location         String?
  contacts         Contact[]
  documents        Document[]
}

model Document {
  id           String   @id @default(cuid())
  name         String
  type         String
  size         String
  uploadedAt   String
  uploadedBy   String
  category     String
  description  String?
  accountId    String?
  caseId       String?
  previewUrl   String?
  account      Account? @relation(fields: [accountId], references: [id])
  case         Case?    @relation(fields: [caseId], references: [id])
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String
  date         String
  status       String
  linkedRecord String?
  contactId    String?
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  meetingId String
  user      User    @relation(fields: [userId], references: [id])
  userId    String

  @@unique([meetingId, userId])
}


model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   String
  read        Boolean
  userId      String?
  link        String
}

model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
  configured     Boolean
}

model Email {
    id String @id @default(cuid())
    from Json
    to Json
    subject String
    body String
    date String
    type String
    read Boolean
    linkedCaseId String?
    attachments Json[] @default([])
}

model GlobalNotificationPreferences {
    id String @id @default(cuid())
    cases Json
    tasks Json
    meetings Json
}

model NotificationPreferences {
    id String @id @default(cuid())
    userId String @unique
    user User @relation(fields: [userId], references: [id])
    cases Json
    tasks Json
    meetings Json
}

model Workflow {
    id String @id @default(cuid())
    name String
    trigger String
    condition String
    action String
}

model AuditLog {
    id String @id @default(cuid())
    userId String
    action String
    details String
    timestamp String
    user User @relation(fields: [userId], references: [id])
}
