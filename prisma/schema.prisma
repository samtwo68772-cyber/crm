// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  name                    String
  passwordHash            String
  avatar                  String?
  role                    String                    @default("staff") // "admin", "staff"
  status                  String                    @default("Active") // "Active", "Inactive"
  team                    String                    @default("")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  tasks                   Task[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreferences?
  caseAssignments         CaseAssignment[]
  meetingParticipants     MeetingParticipant[]
}

model Case {
  id                 String           @id @default(cuid())
  subject            String
  customer           String
  email              String
  priority           String // "High", "Medium", "Low"
  type               String // "Bug Report", "Feature Request", etc.
  status             String // "New", "In Progress", "Resolved"
  createdAt          String
  resolvedAt         String?
  description        String
  communications     Json?
  satisfactionRating Int?
  assignments        CaseAssignment[]
  contactId          String?
  contact            Contact?         @relation(fields: [contactId], references: [id])
  documents          Document[]
  tasks              Task[]
}

model CaseAssignment {
  id         String   @id @default(cuid())
  case       Case     @relation(fields: [caseId], references: [id])
  caseId     String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String // User ID of who assigned the case
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String // "To Do", "In Progress", "Done"
  dueDate     String
  priority    String // "High", "Medium", "Low"
  linkedCase  String?
  case        Case?    @relation(fields: [linkedCase], references: [id])
  assignee    User?    @relation(fields: [assignedTo], references: [id])
  assignedTo  String?
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String?
  date         String
  status       String // "Upcoming", "Completed", "Canceled"
  linkedRecord String?
  contactId    String?
  contact      Contact?             @relation(fields: [contactId], references: [id])
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  meetingId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime @default(now())
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  leaderId    String
  memberIds   String[]
  status      String   @default("Active") // "Active", "Archived"
}

model Account {
  id               String    @id @default(cuid())
  name             String    @unique
  industry         String
  createdAt        String
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  owner            String
  size             String?
  location         String?
  documents        Document[]
  contacts         Contact[]
}

model Document {
  id           String   @id @default(cuid())
  name         String
  type         String
  size         String
  uploadedAt   String
  uploadedBy   String
  category     String
  description  String?
  previewUrl   String?
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id])
  caseId       String?
  case         Case?    @relation(fields: [caseId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp String
}

model Notification {
  id          String  @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   String
  read        Boolean @default(false)
  userId      String?
  link        String
}

model NotificationPreferences {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  cases    Json
  tasks    Json
  meetings Json
}

model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  configured     Boolean @default(false)
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
}

model GlobalNotificationPreferences {
  id       String @id @default(cuid())
  cases    Json
  tasks    Json
  meetings Json
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}

model Email {
  id           String    @id @default(cuid())
  from         Json
  to           Json
  subject      String
  body         String
  date         String
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json?
}

model Contact {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  company   String
  role      String
  notes     String?
  avatar    String?
  accountId String?
  account   Account?  @relation(fields: [accountId], references: [id])
  cases     Case[]
  tasks     Task[]
  meetings  Meeting[]
}
