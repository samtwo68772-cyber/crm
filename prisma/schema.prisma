// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  passwordHash            String
  role                    String
  status                  String
  team                    String
  avatar                  String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  caseAssignments         CaseAssignment[]
  meetingParticipants     MeetingParticipant[]
  tasks                   Task[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreferences?
}

model Team {
  id          String @id @default(cuid())
  name        String @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String
}

model Account {
  id               String    @id @default(cuid())
  name             String
  industry         String
  owner            String
  createdAt        DateTime  @default(now())
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  size             String?
  location         String?
  contacts         Contact[]
  documents        Document[]
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String
  role      String
  notes     String?
  avatar    String
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  cases     Case[]
  meetings  Meeting[]
}

model Case {
  id                 String           @id @default(cuid())
  subject            String
  customer           String
  email              String
  priority           String
  type               String
  status             String
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?
  description        String
  communications     Json[]
  contactId          String?
  satisfactionRating Int?
  contact            Contact?         @relation(fields: [contactId], references: [id])
  tasks              Task[]
  documents          Document[]
  assignments        CaseAssignment[]
}

model CaseAssignment {
  id         String   @id @default(cuid())
  case       Case     @relation(fields: [caseId], references: [id])
  caseId     String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String

  @@unique([caseId, userId])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     DateTime
  priority    String
  linkedCase  String?
  assignedTo  String?
  contactId   String?
  case        Case?    @relation(fields: [linkedCase], references: [id])
  user        User?    @relation(fields: [assignedTo], references: [id])
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String
  date         DateTime
  status       String
  linkedRecord String?
  notes        Json[]
  attachments  Json[]
  contactId    String?
  contact      Contact?             @relation(fields: [contactId], references: [id])
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  meetingId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime @default(now())

  @@unique([meetingId, userId])
}

model Document {
  id          String   @id @default(cuid())
  name        String
  type        String
  size        String
  uploadedAt  DateTime @default(now())
  uploadedBy  String
  category    String
  description String?
  previewUrl  String?
  accountId   String?
  caseId      String?
  account     Account? @relation(fields: [accountId], references: [id])
  case        Case?    @relation(fields: [caseId], references: [id])
}

model Email {
  id           String  @id @default(cuid())
  from         Json
  to           Json
  subject      String
  body         String
  date         DateTime
  type         String
  read         Boolean @default(false)
  linkedCaseId String?
  attachments  Json[]
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())
}

model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  configured     Boolean @default(false)
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
}

model NotificationPreferences {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id])
  userId  String @unique
  cases   Json
  tasks   Json
  meetings Json
}

model GlobalNotificationPreferences {
  id       String @id @default(cuid())
  cases    Json
  tasks    Json
  meetings Json
}
