// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id                        String                     @id @default(cuid())
  name                      String
  email                     String                     @unique
  phone                     String?
  status                    String                     @default("Active") // e.g., Active, Inactive
  team                      String
  avatar                    String
  passwordHash              String
  roleId                    String
  role                      Role                       @relation(fields: [roleId], references: [id])
  assignments               CaseAssignment[]
  meetings                  MeetingParticipant[]
  notificationPreferences   NotificationPreferences?
  createdCases              Case[]                     @relation("CreatedBy")
  assignedCasesBy           CaseAssignment[]           @relation("AssignedBy")
  documents                 Document[]
  auditLogs                 AuditLog[]

  @@index([roleId])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  permissions Json
  users       User[]
}

model Case {
  id                 String           @id @default(cuid())
  subject            String
  customer           String
  email              String
  priority           String
  type               String
  status             String
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?
  description        String
  communications     Json[]           @default([])
  contactId          String?
  satisfactionRating Int?
  assignments        CaseAssignment[]
  createdById        String
  createdBy          User             @relation("CreatedBy", fields: [createdById], references: [id])
  documents          Document[]
  tasks              Task[]
  contact            Contact?         @relation(fields: [contactId], references: [id])


  @@index([contactId])
  @@index([createdById])
}

model CaseAssignment {
  id             String @id @default(cuid())
  caseId         String
  userId         String
  assignedAt     DateTime @default(now())
  assignedByUserId String
  case           Case   @relation(fields: [caseId], references: [id])
  user           User   @relation(fields: [userId], references: [id])
  assignedBy     User   @relation("AssignedBy", fields: [assignedByUserId], references: [id])


  @@index([caseId])
  @@index([userId])
  @@index([assignedByUserId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     DateTime?
  priority    String
  linkedCase  String?
  case        Case?     @relation(fields: [linkedCase], references: [id])
  assignedTo  String?
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])

  @@index([linkedCase])
  @@index([assignedTo])
  @@index([contactId])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String
  accountId String?
  role      String
  notes     String?
  avatar    String
  tasks     Task[]
  cases     Case[]
  account   Account? @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  leaderId    String?
  memberIds   String[]
  status      String
}

model Account {
  id               String    @id @default(cuid())
  name             String    @unique
  industry         String
  createdAt        DateTime  @default(now())
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  owner            String
  contacts         Contact[]
  documents        Document[]
}

model Document {
  id           String    @id @default(cuid())
  name         String
  type         String
  size         String
  uploadedAt   DateTime  @default(now())
  uploadedBy   String
  authorId     String?
  author       User?     @relation(fields: [authorId], references: [id])
  category     String
  description  String?
  accountId    String?
  account      Account?  @relation(fields: [accountId], references: [id])
  caseId       String?
  case         Case?     @relation(fields: [caseId], references: [id])
  previewUrl   String?
  linkedToId   String?
  linkedToType String?

  @@index([authorId])
  @@index([accountId])
  @@index([caseId])
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  status       String
  linkedRecord String?
  contactId    String?
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  joinedAt  DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([meetingId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Email {
  id           String @id @default(cuid())
  ownerEmail   String
  from         Json
  to           Json
  subject      String
  body         String
  date         DateTime
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json[] @default([])
  messageId    String?
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   DateTime @default(now())
  read        Boolean
  userId      String?
  link        String
}

model NotificationPreferences {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  cases    Json
  tasks    Json
  meetings Json
}

model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
  configured     Boolean
}

model GlobalNotificationPreferences {
  id       String @id @default(cuid())
  cases    Json
  tasks    Json
  meetings Json
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}
