
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  passwordHash            String
  role                    String
  status                  String                    @default("Active")
  team                    String
  avatar                  String?
  assignments             CaseAssignment[]
  tasks                   Task[]
  meetings                MeetingParticipant[]
  notificationPreferences NotificationPreferences?
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String   @default("Active")
}

model Account {
  id               String    @id @default(cuid())
  name             String
  industry         String
  owner            String
  createdAt        DateTime
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  contacts         Contact[]
  documents        Document[]
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  company   String
  role      String
  notes     String?
  avatar    String?
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  cases     Case[]
  tasks     Task[]
  meetings  Meeting[]
}

model Case {
  id                 String           @id @default(cuid())
  subject            String
  customer           String
  email              String
  description        String
  priority           String
  type               String
  status             String           @default("New")
  createdAt          DateTime         @default(now())
  resolvedAt         String?
  contactId          String?
  contact            Contact?         @relation(fields: [contactId], references: [id])
  satisfactionRating Int?
  communications     Json[]
  assignments        CaseAssignment[]
  tasks              Task[]
  documents          Document[]
}

model CaseAssignment {
  id             String   @id @default(cuid())
  case           Case     @relation(fields: [caseId], references: [id])
  caseId         String
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  assignedAt     DateTime @default(now())
  assignedByUserId String
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("To Do")
  dueDate     String
  priority    String
  linkedCase  String?
  case        Case?    @relation(fields: [linkedCase], references: [id])
  assignedTo  String?
  user        User?    @relation(fields: [assignedTo], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String?
  date         String
  status       String               @default("Upcoming")
  linkedRecord String?
  notes        Json[]
  attachments  Json[]
  contactId    String?
  contact      Contact?             @relation(fields: [contactId], references: [id])
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  meetingId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  name        String
  type        String
  size        String
  uploadedAt  String
  uploadedBy  String
  authorId    String
  category    String
  description String?
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  previewUrl  String?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  timestamp String
}

model Email {
  id           String @id @default(cuid())
  from         Json
  to           Json
  subject      String
  body         String
  date         String
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json[]
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}

// User-specific notification preferences, overriding global defaults
model NotificationPreferences {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  cases    Json
  tasks    Json
  meetings Json
}

// Global settings models
model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String?
  timeZone    String
  language    String
}

model EmailSettings {
  id             String @id @default(cuid())
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
  configured     Boolean @default(false)
}

model GlobalNotificationPreferences {
  id       String @id @default(cuid())
  cases    Json
  tasks    Json
  meetings Json
}
