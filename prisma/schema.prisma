// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  passwordHash            String
  role                    String // "admin" or "staff"
  status                  String
  team                    String
  avatar                  String
  notificationPreferences NotificationPreferences?
  caseAssignments         CaseAssignment[]
  meetingParticipants     MeetingParticipant[]
  documents               Document[]
  auditLogs               AuditLog[]
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String // "Active" or "Archived"
}

model Account {
  id               String    @id @default(cuid())
  name             String    @unique
  industry         String
  owner            String
  createdAt        DateTime  @default(now())
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  contacts         Contact[]
  documents        Document[]
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  company   String
  role      String
  notes     String?
  avatar    String
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  cases     Case[]
  meetings  Meeting[]
}

model Case {
  id                 String           @id
  subject            String
  customer           String
  email              String
  priority           String
  type               String
  status             String
  createdAt          String
  resolvedAt         String?
  description        String
  communications     Json[]
  contactId          String?
  contact            Contact?         @relation(fields: [contactId], references: [id])
  satisfactionRating Int?
  assignments        CaseAssignment[]
  tasks              Task[]
  documents          Document[]
}

model CaseAssignment {
  id             String @id @default(cuid())
  caseId         String
  case           Case   @relation(fields: [caseId], references: [id])
  userId         String
  user           User   @relation(fields: [userId], references: [id])
  assignedByUserId String
  assignedAt     DateTime @default(now())

  @@unique([caseId, userId])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     String
  priority    String
  linkedCase  String?
  assignedTo  String?
  case        Case?   @relation(fields: [linkedCase], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String
  date         String
  status       String
  linkedRecord String?
  contactId    String?
  contact      Contact?             @relation(fields: [contactId], references: [id])
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  joinedAt  DateTime @default(now())

  @@unique([meetingId, userId])
}

model Document {
  id          String   @id @default(cuid())
  name        String
  type        String
  size        String
  uploadedAt  String
  uploadedBy  String
  category    String
  description String?
  previewUrl  String?
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  authorId    String   @default("user-1") // Default to admin user
  author      User     @relation(fields: [authorId], references: [id])
}

model Email {
  id           String  @id @default(cuid())
  from         Json
  to           Json
  subject      String
  body         String
  date         String
  type         String // "inbox" or "sent"
  read         Boolean
  linkedCaseId String?
  attachments  Json[]
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp String
}

model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
  configured     Boolean
}

model NotificationPreferences {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  cases    Json
  tasks    Json
  meetings Json
}

model GlobalNotificationPreferences {
    id       String @id @default(cuid())
    cases    Json
    tasks    Json
    meetings Json
}
