
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                      @id @default(cuid())
  name                      String
  email                     String                      @unique
  passwordHash              String
  role                      String
  status                    String
  team                      String
  avatar                    String
  caseAssignments           CaseAssignment[]
  meetingParticipants       MeetingParticipant[]
  notificationPreferences   NotificationPreferences?
  createdCases              Case[]                      @relation("CreatedBy")
  auditLogEntries           AuditLog[]
}

model Case {
  id                 String           @id @default(cuid())
  subject            String
  customer           String
  email              String
  priority           String
  type               String
  status             String
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?
  description        String
  communications     Json[]
  contactId          String?
  satisfactionRating Int?
  assignments        CaseAssignment[]
  tasks              Task[]
  documents          Document[]
  createdBy          User             @relation("CreatedBy", fields: [createdById], references: [id])
  createdById        String
}

model CaseAssignment {
  id               String   @id @default(cuid())
  case             Case     @relation(fields: [caseId], references: [id])
  caseId           String
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     DateTime?
  priority    String
  linkedCase  String?
  assignedTo  String?
  case        Case?     @relation(fields: [linkedCase], references: [id])
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
}

model Contact {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  company   String
  accountId String?
  role      String?
  notes     String?
  avatar    String
  account   Account?  @relation(fields: [accountId], references: [id])
  tasks     Task[]
  meetings  Meeting[]
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String
}

model Account {
  id               String    @id @default(cuid())
  name             String    @unique
  industry         String
  owner            String
  createdAt        DateTime
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  contacts         Contact[]
  documents        Document[]
}

model Document {
  id           String   @id @default(cuid())
  name         String
  type         String
  size         String
  uploadedAt   DateTime @default(now())
  uploadedBy   String
  authorId     String   @default("user-1")
  category     String
  description  String?
  previewUrl   String?
  case         Case?    @relation(fields: [caseId], references: [id])
  caseId       String?
  account      Account? @relation(fields: [accountId], references: [id])
  accountId    String?
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String
  date         DateTime
  status       String
  linkedRecord String?
  notes        Json?
  attachments  Json?
  contactId    String?
  contact      Contact?             @relation(fields: [contactId], references: [id])
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  meetingId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())
}

model Email {
  id           String  @id @default(cuid())
  from         Json
  to           Json
  subject      String
  body         String
  date         DateTime
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json[]
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   DateTime @default(now())
  read        Boolean
  userId      String?
  link        String
}

model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
  configured     Boolean @default(false)
}

model NotificationPreferences {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String @unique
  cases    Json
  tasks    Json
  meetings Json
}

model GlobalNotificationPreferences {
  id       String @id @default(cuid())
  cases    Json
  tasks    Json
  meetings Json
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}
