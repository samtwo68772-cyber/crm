// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}


model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  passwordHash            String
  role                    String
  status                  String
  team                    String
  avatar                  String
  notificationPreferences NotificationPreferences?
  assignments             CaseAssignment[]
  meetings                MeetingParticipant[]
  createdCases            Case[]                    @relation("CreatedBy")
}

model Case {
  id                 String           @id @default(cuid())
  subject            String
  customer           String
  email              String
  priority           String
  type               String
  status             String           @default("New")
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?
  description        String
  communications     Json[]
  satisfactionRating Int?
  assignments        CaseAssignment[]
  tasks              Task[]
  documents          Document[]
  contactId          String?
  contact            Contact?         @relation(fields: [contactId], references: [id])
  createdBy          User?            @relation("CreatedBy", fields: [createdById], references: [id])
  createdById        String?
}

model CaseAssignment {
  id               String   @id @default(cuid())
  case             Case     @relation(fields: [caseId], references: [id])
  caseId           String
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String?

  @@unique([caseId, userId])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     DateTime
  priority    String
  linkedCase  String?
  assignedTo  String?
  contactId   String?
  case        Case?    @relation(fields: [linkedCase], references: [id])
  contact     Contact? @relation(fields: [contactId], references: [id])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String
  role      String?
  notes     String?
  avatar    String
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  cases     Case[]
  tasks     Task[]
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String
}

model Account {
  id               String    @id @default(cuid())
  name             String
  industry         String
  owner            String
  createdAt        DateTime  @default(now())
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  contacts         Contact[]
  documents        Document[]
}

model Document {
  id          String   @id @default(cuid())
  name        String
  type        String
  size        String
  uploadedAt  DateTime @default(now())
  uploadedBy  String
  category    String
  description String?
  previewUrl  String?
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  authorId    String   @default("user-1")
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  status       String
  linkedRecord String?
  contactId    String?
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  meetingId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime @default(now())

  @@unique([meetingId, userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  timestamp DateTime @default(now())
}

model Email {
  id           String    @id @default(cuid())
  from         Json
  to           Json
  subject      String
  body         String
  date         DateTime
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json[]
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}

model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
  configured     Boolean @default(false)
}

model NotificationPreferences {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  cases    Json
  tasks    Json
  meetings Json
}

model GlobalNotificationPreferences {
  id       String @id @default(cuid())
  cases    Json
  tasks    Json
  meetings Json
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   DateTime @default(now())
  read        Boolean
  userId      String?
  link        String
}
