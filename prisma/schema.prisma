// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
  shadowDatabaseUrl = env("POSTGRES_URL_NON_POOLING") // used for migrations
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  phone                   String?
  status                  String                    @default("Active")
  team                    String
  avatar                  String
  passwordHash            String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  roleId                  String
  role                    Role                      @relation(fields: [roleId], references: [id])
  assignments             CaseAssignment[]
  meetings                MeetingParticipant[]
  notificationPreferences NotificationPreferences[]
  createdCases            Case[]                    @relation("CreatedBy")
  assignedCasesBy         CaseAssignment[]          @relation("AssignedBy")
  documents               Document[]
  auditLogs               AuditLog[]
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  permissions Json
  users       User[]
}

model Case {
  id                 String           @id @default(cuid())
  subject            String
  customer           String
  email              String
  priority           String
  type               String
  status             String
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?
  description        String?
  communications     Json[]           @default("[]")
  contactId          String?
  satisfactionRating Int?
  assignments        CaseAssignment[]
  createdById        String
  createdBy          User             @relation("CreatedBy", fields: [createdById], references: [id])
  documents          Document[]
}

model CaseAssignment {
  id               String   @id @default(cuid())
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id])
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  assignedAt       DateTime @default(now())
  assignedByUserId String
  assignedByUser   User     @relation("AssignedBy", fields: [assignedByUserId], references: [id])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     DateTime?
  priority    String
  linkedCase  String?
  assignedTo  String?
  contactId   String?
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  role      String
  notes     String?
  avatar    String
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String   @default("Active")
}

model Account {
  id               String    @id @default(cuid())
  name             String    @unique
  industry         String
  createdAt        DateTime  @default(now())
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  owner            String
  size             String?
  location         String?
  contacts         Contact[]
  documents        Document[]
}

model Document {
  id           String   @id @default(cuid())
  name         String
  type         String
  size         String
  uploadedAt   DateTime @default(now())
  uploadedBy   String
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id])
  category     String
  description  String?
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id])
  caseId       String?
  case         Case?    @relation(fields: [caseId], references: [id])
  previewUrl   String?
  linkedToId   String?
  linkedToType String?
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  status       String
  linkedRecord String?
  notes        Json[]               @default("[]")
  attachments  Json[]               @default("[]")
  contactId    String?
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  joinedAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())
}

model Email {
  id           String @id @default(cuid())
  ownerEmail   String
  from         Json
  to           Json
  subject      String
  body         String
  date         DateTime
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json[]   @default("[]")
  messageId    String?
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   DateTime @default(now())
  read        Boolean
  userId      String?
  link        String
}

model NotificationPreferences {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  cases    Json
  tasks    Json
  meetings Json
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}

model GeneralSettings {
  id          String  @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String?
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  configured     Boolean @default(false)
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
}

model GlobalNotificationPreferences {
  id       String @id @default(cuid())
  cases    Json
  tasks    Json
  meetings Json
}
