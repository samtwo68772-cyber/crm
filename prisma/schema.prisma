datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  phone                   String?
  passwordHash            String
  status                  String                    @default("Active") // Active, Inactive
  team                    String
  avatar                  String?
  assignments             CaseAssignment[]
  meetings                MeetingParticipant[]
  notificationPreferences NotificationPreferences?
  AuditLog                AuditLog[]
  createdCases            Case[]                    @relation("CreatedBy")
  documents               Document[]

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String // foreign key to User
  memberIds   String[]
  status      String   @default("Active") // Active, Archived
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  permissions Json
  users       User[]
}

model Account {
  id               String     @id @default(cuid())
  name             String     @unique
  industry         String
  createdAt        DateTime   @default(now())
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  owner            String
  contacts         Contact[]
  documents        Document[]
}

model Contact {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  company   String
  accountId String?
  role      String?
  notes     String?
  avatar    String?
  tasks     Task[]
  cases     Case[]
  meetings  Meeting[]
  account   Account?  @relation(fields: [accountId], references: [id])
}

model Case {
  id                 String           @id
  subject            String
  customer           String
  email              String
  priority           String // High, Medium, Low
  type               String // Bug Report, Feature Request, etc.
  status             String // New, In Progress, Resolved, etc.
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?
  description        String
  communications     Json[]
  satisfactionRating Int?
  contactId          String?
  contact            Contact?         @relation(fields: [contactId], references: [id])
  assignments        CaseAssignment[]
  documents          Document[]

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])
}

model CaseAssignment {
  id               String   @id @default(cuid())
  caseId           String
  userId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String // User who made the assignment
  case             Case     @relation(fields: [caseId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String // To Do, In Progress, Done, Canceled
  dueDate     DateTime?
  priority    String // High, Medium, Low
  linkedCase  String?
  assignedTo  String?
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  status       String // Upcoming, Completed, Canceled
  linkedRecord String?
  contactId    String?
  contact      Contact?             @relation(fields: [contactId], references: [id])
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  joinedAt  DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Document {
  id           String  @id @default(cuid())
  name         String
  type         String // PDF, Document, Spreadsheet, Image, Meeting
  size         String
  uploadedAt   DateTime
  uploadedBy   String
  category     String
  description  String?
  authorId     String?
  author       User?   @relation(fields: [authorId], references: [id])
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id])
  caseId       String?
  case         Case?   @relation(fields: [caseId], references: [id])
  previewUrl   String?
  linkedToId   String?
  linkedToType String?
}

model Email {
  id           String    @id @default(cuid())
  ownerEmail   String // Identifies which user's mailbox this belongs to
  from         Json // { name: string, email: string }
  to           Json // { name: string, email: string }
  subject      String
  body         String
  date         DateTime
  type         String // inbox, sent
  read         Boolean   @default(false)
  linkedCaseId String?
  attachments  Json[]
  messageId    String?   @unique
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime
}

model Notification {
  id          String   @id @default(cuid())
  userId      String? // null for system-wide
  type        String // case, task, meeting, email
  title       String
  description String
  link        String
  timestamp   DateTime
  read        Boolean  @default(false)
}

model NotificationPreferences {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  cases    Json
  tasks    Json
  meetings Json
}

// Global, system-wide settings
model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String?
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  configured     Boolean @default(false)
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
}

model GlobalNotificationPreferences {
  id       String @id @default(cuid())
  cases    Json
  tasks    Json
  meetings Json
}
