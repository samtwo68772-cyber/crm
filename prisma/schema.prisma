
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  passwordHash            String
  avatar                  String
  role                    String                    @default("staff")
  status                  String                    @default("Active")
  team                    String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  
  assignedCases           CaseAssignment[]
  tasks                   Task[]
  meetingsAsParticipant   MeetingParticipant[]
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreferences?
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String   @default("Active")
}

model Case {
  id                 String           @id @default(cuid())
  subject            String
  customer           String
  email              String
  priority           String
  type               String
  status             String
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?
  description        String
  communications     Json[]
  contactId          String?
  satisfactionRating Int?

  assignments        CaseAssignment[]
  tasks              Task[]
  documents          Document[]
  contact            Contact?         @relation(fields: [contactId], references: [id])
}

model CaseAssignment {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  assignedAt DateTime @default(now())
  
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([caseId, userId])
}


model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     DateTime
  priority    String
  linkedCase  String?
  assignedTo  String?
  contactId   String?

  user        User?      @relation(fields: [assignedTo], references: [id])
  case      Case?      @relation(fields: [linkedCase], references: [id])
  contact     Contact?   @relation(fields: [contactId], references: [id])
}

model Contact {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  company   String
  accountId String?
  role      String
  notes     String?
  avatar    String

  account   Account?  @relation(fields: [accountId], references: [id])
  cases     Case[]
  tasks     Task[]
  meetings  Meeting[]
}

model Account {
  id               String    @id @default(cuid())
  name             String    @unique
  industry         String
  createdAt        DateTime  @default(now())
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  owner            String
  
  contacts         Contact[]
  documents        Document[]
}

model Document {
  id          String   @id @default(cuid())
  name        String
  type        String
  size        String
  uploadedAt  DateTime @default(now())
  uploadedBy  String
  category    String
  description String?
  previewUrl  String?
  
  accountId   String?
  caseId      String?
  account     Account? @relation(fields: [accountId], references: [id])
  case        Case?    @relation(fields: [caseId], references: [id])
}


model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String
  date         DateTime
  status       String
  linkedRecord String?
  contactId    String?
  
  contact      Contact?             @relation(fields: [contactId], references: [id])
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  timestamp DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
}

model Email {
  id           String @id @default(cuid())
  from         Json
  to           Json
  subject      String
  body         String
  date         DateTime
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json[]
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   DateTime @default(now())
  read        Boolean  @default(false)
  userId      String?
  link        String
}

model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  configured     Boolean @default(false)
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
}

model NotificationPreferences {
    id        String @id @default(cuid())
    userId    String @unique
    cases     Json
    tasks     Json
    meetings  Json
    
    user User @relation(fields: [userId], references: [id])
}

model GlobalNotificationPreferences {
    id       String @id @default(cuid())
    cases    Json
    tasks    Json
    meetings Json
}

