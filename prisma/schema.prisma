// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  phone                   String?
  role                    String
  status                  String
  team                    String
  avatar                  String
  passwordHash            String
  caseAssignments         CaseAssignment[]
  meetingParticipations   MeetingParticipant[]
  notificationPreferences NotificationPreferences?
  auditLogs               AuditLog[]
  documents               Document[]
  createdCases            Case[]
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String
}

model Account {
  id               String     @id @default(cuid())
  name             String     @unique
  industry         String
  owner            String
  createdAt        DateTime   @default(now())
  address          String?
  phone            String?
  email            String?
  website          String?
  primaryContactId String?
  documents        Document[]
}

model Contact {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  company   String
  role      String
  notes     String?
  avatar    String
  accountId String?
  cases     Case[]
  tasks     Task[]
  meetings  Meeting[]
}

model Case {
  id                 String           @id @default(cuid())
  subject            String
  customer           String
  email              String
  priority           String
  type               String
  status             String
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?
  description        String
  communications     Json[]
  satisfactionRating Int?
  assignments        CaseAssignment[]
  createdById        String
  createdBy          User             @relation(fields: [createdById], references: [id])
  contact            Contact?         @relation(fields: [contactId], references: [id])
  contactId          String?
  documents          Document[]
}

model CaseAssignment {
  id               String   @id @default(cuid())
  case             Case     @relation(fields: [caseId], references: [id])
  caseId           String
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String
}


model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String
  dueDate     DateTime?
  priority    String
  linkedCase  String?
  assignedTo  String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  contactId   String?
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String
  date         DateTime
  status       String
  linkedRecord String?
  notes        Json[]
  attachments  Json[]
  participants MeetingParticipant[]
  contact      Contact?             @relation(fields: [contactId], references: [id])
  contactId    String?
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  meetingId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime @default(now())
}

model Document {
  id           String   @id @default(cuid())
  name         String
  type         String
  size         String
  uploadedAt   DateTime @default(now())
  uploadedBy   String
  category     String
  description  String?
  previewUrl   String?
  linkedToId   String?
  linkedToType String?
  case         Case?    @relation(fields: [caseId], references: [id])
  caseId       String?
  account      Account? @relation(fields: [accountId], references: [id])
  accountId    String?
  author       User?    @relation(fields: [authorId], references: [id])
  authorId     String?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())
}

model Email {
  id           String @id @default(cuid())
  ownerEmail   String
  from         Json
  to           Json
  subject      String
  body         String
  date         DateTime
  type         String
  read         Boolean
  linkedCaseId String?
  attachments  Json[]
  messageId    String?  @unique
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   DateTime @default(now())
  read        Boolean
  userId      String?
  link        String
}

model NotificationPreferences {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String @unique
  cases    Json
  tasks    Json
  meetings Json
}

model GlobalNotificationPreferences {
    id       String @id @default(cuid())
    cases    Json
    tasks    Json
    meetings Json
}

model GeneralSettings {
    id          String @id @default(cuid())
    systemName  String
    companyName String
    logoUrl     String
    timeZone    String
    language    String
}

model EmailSettings {
    id              String @id @default(cuid())
    smtpHost        String
    smtpPort        Int
    smtpUser        String
    smtpPass        String
    smtpEncryption  String
    imapHost        String
    imapPort        Int
    imapUser        String
    imapPass        String
    imapEncryption  String
    configured      Boolean
}

model Workflow {
  id        String @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
}
