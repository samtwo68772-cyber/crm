// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  passwordHash            String
  role                    String // "admin" or "staff"
  status                  String // "Active" or "Inactive"
  team                    String
  avatar                  String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  assignedCases           Case[]                    @relation("AssignedToUser")
  tasks                   Task[]
  meetingsAsParticipant   Meeting[]                 @relation("MeetingParticipants")
  auditLogs               AuditLog[]
  notificationPreferences NotificationPreferences?
  notifications           Notification[]            @relation("UserNotifications")
}

model Case {
  id               String          @id @default(cuid())
  subject          String
  customer         String
  email            String
  priority         String // "High", "Medium", "Low"
  type             String
  status           String
  assignedTo       String[]
  createdAt        String
  resolvedAt       String?
  description      String
  communications   Json[]
  contactId        String?
  satisfactionRating Int?

  assignees      User[]          @relation("AssignedToUser", fields: [assignedTo], references: [id])
  contact        Contact?        @relation(fields: [contactId], references: [id])
  documents      Document[]
  tasks          Task[]
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String // "To Do", "In Progress", "Done", "Canceled"
  dueDate     String
  priority    String // "High", "Medium", "Low"
  linkedCase  String?
  assignedTo  String?
  contactId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee  User?    @relation(fields: [assignedTo], references: [id])
  contact   Contact? @relation(fields: [contactId], references: [id])
  case      Case?    @relation(fields: [linkedCase], references: [id])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String
  role      String
  notes     String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accountId String?

  account  Account?   @relation(fields: [accountId], references: [id])
  cases    Case[]
  tasks    Task[]
  meetings Meeting[]
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  leaderId    String
  memberIds   String[]
  status      String // "Active" or "Archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id               String    @id @default(cuid())
  name             String    @unique
  industry         String
  createdAt        DateTime
  address          String?
  phone            String?
  email            String?   @unique
  website          String?
  primaryContactId String?
  owner            String
  size             String?
  location         String?
  contacts         Contact[]
  documents        Document[]
}

model Document {
  id           String   @id @default(cuid())
  name         String
  type         String
  size         String
  uploadedAt   String
  uploadedBy   String
  category     String
  description  String?
  accountId    String?
  caseId       String?
  previewUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  account      Account? @relation(fields: [accountId], references: [id])
  case         Case?    @relation(fields: [caseId], references: [id])
}

model Meeting {
  id           String   @id @default(cuid())
  title        String
  description  String
  date         String
  status       String // "Upcoming", "Completed", "Canceled"
  participants String[]
  linkedRecord String?
  notes        Json?
  attachments  Json?
  contactId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contact     Contact? @relation(fields: [contactId], references: [id])
  participantUsers User[]   @relation("MeetingParticipants", fields: [participants], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  timestamp String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Email {
  id           String  @id @default(cuid())
  from         Json
  to           Json
  subject      String
  body         String
  date         String
  type         String // "inbox" or "sent"
  read         Boolean
  linkedCaseId String?
  attachments  Json?
}

model GeneralSettings {
  id          String @id @default(cuid())
  systemName  String
  companyName String
  logoUrl     String?
  timeZone    String
  language    String
}

model EmailSettings {
  id             String  @id @default(cuid())
  configured     Boolean @default(false)
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String
  imapHost       String
  imapPort       Int
  imapUser       String
  imapPass       String
  imapEncryption String
}

model NotificationPreferences {
  id       String @id @default(cuid())
  userId   String @unique
  cases    Json
  tasks    Json
  meetings Json

  user User @relation(fields: [userId], references: [id])
}

model GlobalNotificationPreferences {
    id String @id @default(cuid())
    cases    Json
    tasks    Json
    meetings Json
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  timestamp   String
  read        Boolean
  userId      String?
  link        String
  createdAt   DateTime @default(now())
  
  user User? @relation("UserNotifications", fields: [userId], references: [id])
}

model Workflow {
    id String @id @default(cuid())
    name String
    trigger String
    condition String
    action String
}
